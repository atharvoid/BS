# ---------------------------------------------------------------------------
# Enquiry delivery
#
# The form posts to Web3Forms and uses its built-in spam filtering.
# The selected Web3Forms form must allow submissions without a CAPTCHA.
# ---------------------------------------------------------------------------

# Public access key from web3forms.com (safe to expose in the browser).
VITE_WEB3FORMS_KEY=

# Optional manual recovery contact. The form key sets the delivery recipient.
VITE_ENQUIRY_CONTACT_EMAIL=

# Optional verified public origin for route canonical/share URLs. No trailing path.
VITE_SITE_URL=
