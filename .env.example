# ---------------------------------------------------------------------------
# Enquiry delivery
#
# The form posts to Web3Forms. CAPTCHA integration is reserved, not active.
# Leave these unset and the form will refuse to fake a submission: it shows
# the visitor an honest "not connected yet" note instead of a success message.
#
# The project handoff records that account setup and real delivery are still
# UNVERIFIED. Configure the key, then send a test enquiry to the business
# inbox and confirm it actually arrives before relying on this form.
# ---------------------------------------------------------------------------

# Public access key from web3forms.com (safe to expose in the browser).
VITE_WEB3FORMS_KEY=

# Reserved: leave empty until a real CAPTCHA widget/token flow is integrated.
# Configuring this currently disables online sending rather than posting an invalid token.
VITE_HCAPTCHA_SITEKEY=

# Optional verified public origin for route canonical/share URLs. No trailing path.
VITE_SITE_URL=
